{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "DataDirectory": "data"
  },
  "Jwt": {
    "SigningKey": ""
  },
  "Live": {
    "TickMs": 250,
    "AwayGraceSeconds": 120
  },
  "RateLimit": {
    "IdentityRequestsPerMinute": 20,
    "CodeJoinsPerMinute": 10
  }
}
